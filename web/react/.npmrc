# 依赖安装加固：解决 CI/构建平台偶发的 npm "Exit handler never called!" 崩溃
# 背景：npm 依赖数超过默认 maxsockets(15) 时，若 registry 请求超时，
#       agent-base 会悬空排队请求导致 npm 异常退出且 node_modules 不完整。
#       (参考 npm/cli#9386、npm/cli#7657)
# - 提高并发连接数，让单个包超时快速失败而非整批卡死
maxsockets=128
# 镜像源优先走腾讯云 npm 镜像（与当前环境一致），并对 registry 做超时/重试兜底
registry=https://mirrors.tencentyun.com/npm
# 超时与重试
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=60000
# 构建环境跳过干扰项，加快安装
audit=false
fund=false