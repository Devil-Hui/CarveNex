# =============================================================================
# CarveNex 本地测试环境变量（.env.test）
# ------------------------------------------------------------
# 用法：本地跑测试时使用本文件
#   docker compose --env-file .env.test up --build
# 或（backend/docker-compose.yml 已默认读取 ../.env.test）
#   docker compose up --build
#
# 与 .env.production（公网部署）区分：本文件面向本地测试，
# DJANGO_ENV=test，使用本地 MySQL/Redis，不暴露公网。
# 本文件不含真实生产凭证，可安全入库；真实值请勿提交。
# =============================================================================

# ── 运行环境：test（本地测试）──
DJANGO_ENV=test
DJANGO_SECRET_KEY=test-only-secret-key-not-for-production
DOMAIN=http://127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,web,django-app,carvenex-django,nginx,carvenex-nginx
CORS_ORIGINS=http://127.0.0.1,http://localhost

# ── 数据库（本地 MySQL，测试库）──
DB_ENGINE=django.db.backends.mysql
DB_NAME=carvenex_test
DB_USER=carvenex
DB_PASSWORD=carvenex_test
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=carvenex_test_root

# ── Redis ──
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/4
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ── 文件存储：本地 ──
FILE_STORAGE=local
STATIC_ROOT=/backend/static
MEDIA_PATH=media

# ── 测试模式：启用支付模拟器，不依赖真实网关 ──
ENABLE_MOCK_PAYMENT=true
# Mock 支付签名密钥：必须显式配置独立密钥（绝不回退 SECRET_KEY），
# 未配置时 Mock 支付会被禁用（fail-closed）。测试环境用独立测试密钥即可。
MOCK_PAYMENT_SECRET=test-only-mock-payment-secret-not-for-production

# ── Gunicorn（本地测试轻量配置）──
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=warning

# ── Celery ──
CELERY_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=40
CELERY_MAX_MEMORY_PER_CHILD=120000

# ── 本地/演示用 build args ──
APP_VERSION=test
GIT_COMMIT=test
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEod4A8ngpZCK06H

# ── TLS 证书路径（本地测试用自签证书）──
TLS_CERT_PATH=./deploy/nginx-certs/tunnel.crt
TLS_KEY_PATH=./deploy/nginx-certs/tunnel.key

# ── Cloudflare Turnstile 后端密钥（测试用）──
TURNSTILE_SECRET_KEY=0x4AAAAAAEod4GyCMLlrjbsthc5ndyMdgTs