# CarveNex 生产监控凭据（gitignored，绝不入库）
# 复制为 .env.monitoring 并填写真实值

# ── 告警邮件（SMTP：复用生产 163 账户；to 固定 deaven-hui@carvenex.com） ──
ALERT_EMAIL_HOST=smtp.163.com
ALERT_EMAIL_PORT=465
ALERT_EMAIL_FROM=<163 邮箱>
ALERT_EMAIL_PASSWORD=<163 SMTP 授权码>
ALERT_EMAIL_TO=deaven-hui@carvenex.com

# ── 企业微信告警（微信渠道）：企业微信群 → 添加群机器人 → 复制 Webhook ──
WECHAT_WEBHOOK=

# ── QQ 告警（需自建 OneBot 实例，如 go-cqhttp/NoneBot；未配置则自动跳过） ──
QQBOT_API=
QQBOT_TOKEN=
QQBOT_GROUP_ID=

# ── 钉钉机器人（可选，保留并行；未配置则不启动 dingtalk-hook） ──
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ── Grafana 管理员密码（默认 carvenex-admin） ──
GF_ADMIN_PASSWORD=
