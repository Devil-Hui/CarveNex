# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Git ──
.git/
.gitignore
.gitattributes

# ── Docker ──
Dockerfile*
docker-compose*
.dockerignore

# ── Environment ──
.env
.env.local
.env.*.local

# ── Logs ──
logs/*.log
*.log

# ── Media & Static (mounted at runtime) ──
# 必须加 / 锚定构建上下文根：写成 media/* 会连带排除 apps/media/*，
# 导致镜像里缺失 media 这个 Django app（ModuleNotFoundError: No module named 'apps.media'）
/media/*
!/media/.gitkeep
/static/*
!/static/.gitkeep

# ── Test ──
.tox/
.coverage
htmlcov/
test-results/
playwright-report/

# ── OS ──
.DS_Store
Thumbs.db
