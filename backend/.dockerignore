# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Git ──
.git/
.gitignore
.gitattributes

# ── Docker ──
Dockerfile*
docker-compose*
.dockerignore

# ── Environment ──
.env
.env.local
.env.*.local

# ── Logs ──
logs/*.log
*.log

# ── Media & Static (mounted at runtime) ──
# 必须加 / 锚定构建上下文根：写成 media/* 会连带排除 apps/media/*，
# 导致镜像里缺失 media 这个 Django app（ModuleNotFoundError: No module named 'apps.media'）
/media/*
!/media/.gitkeep
/static/*
!/static/.gitkeep

# 运行期 MEDIA_ROOT（BASE_DIR=project → project/media）：由 seed_products 从
# seed_products/ 重新生成四尺寸图，或由运行时卷挂载提供，无需打进镜像（约 144MB）。
# 注意：生产卷必须挂到 /app/project/media（与 MEDIA_ROOT 一致），见 docker-compose.prod.yml。
project/media/

# ── Test ──
# 生产镜像不需要测试与覆盖率产物（contracts/ 为契约基线，仅 CI 使用）
.tox/
.coverage
htmlcov/
test-results/
playwright-report/
tests/
.pytest_cache/
.mypy_cache/
coverage*.json
allure-results/
allure-report/

# ── MySQL 镜像自有构建文件（构建 Django 镜像用不到）──
mysql/

# ── 本地数据库与证书 ──
*.db
*.sqlite3

# ── OS ──
.DS_Store
Thumbs.db
